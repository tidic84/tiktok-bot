# Configuration du Bot TikTok
# Copiez ce fichier en .env et remplissez vos valeurs

# ========================================
# IDENTIFIANTS TIKTOK
# ========================================
TIKTOK_USERNAME=email@example.com
TIKTOK_PASSWORD=password123

# ========================================
# IDENTIFIANTS INSTAGRAM (si SOURCE_PLATFORM='instagram' dans config.py)
# ========================================
INSTAGRAM_USERNAME=votre_username_instagram
INSTAGRAM_PASSWORD=votre_mot_de_passe_instagram

# NOTE: Pour créer une session Instagram (plus sécurisé que le mot de passe) :
# 1. Installez instaloader: pip install instaloader
# 2. Connectez-vous: instaloader -l votre_username_instagram
# 3. Un fichier de session sera créé automatiquement
# 4. Configurez INSTAGRAM_SESSION_FILE dans config.py

# ========================================
# CRÉATEURS TIKTOK À SUIVRE
# ========================================
# Liste des créateurs TikTok (séparés par des virgules)
# Utilisé si SOURCE_PLATFORM='tiktok' et SCRAPING_MODE='creators' dans config.py
# Exemples pour food/recipes:
TARGET_CREATORS=user1,user2,user3,user4,user5

# Autres exemples par niche:
# Gaming: ninja,pokimane,tfue
# Fitness: chloe_t,blogilates,kayla_itsines
# DIY/Crafts: 5minutecrafts,diyqueen,craftsbymeghan
# Fashion: charlidamelio,addisonre,avani
# Comedy: zachking,brittany_broski,spencerx

# ========================================
# CRÉATEURS INSTAGRAM À SUIVRE
# ========================================
# Liste des créateurs Instagram (séparés par des virgules)
# Utilisé si SOURCE_PLATFORM='instagram' dans config.py
# IMPORTANT: Instagram nécessite une authentification (voir section IDENTIFIANTS INSTAGRAM ci-dessus)
INSTAGRAM_CREATORS=creator1,creator2,creator3

# ========================================
# HASHTAGS
# ========================================
MAX_HASHTAGS=5

# ========================================
# VIDEOS
# ========================================
MIN_LIKES=100
MIN_VIEWS=5000
MIN_ENGAGEMENT_RATE=0.03

# ========================================
# LIMITES QUOTIDIENS
# ========================================
MAX_VIDEOS_PER_DAY=50
ACTIVE_HOURS_START=0
ACTIVE_HOURS_END=24
# ========================================
# NOTES
# ========================================
# - Ne mettez pas d'espaces autour des virgules
# - N'incluez pas le @ devant les noms d'utilisateurs
# - Vous pouvez ajouter autant de créateurs que vous voulez
# - Plus vous en ajoutez, plus le bot aura de contenu à choisir